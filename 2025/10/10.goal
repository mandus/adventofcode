\j:,/'"v"$'-1_'1_'(|'d)@`0 / target joltage
/b:*'|'l / buttons
\b:{w:1+|/,//x; ({@[x#0;y;:;1]}w)'x}',/''"v"$'*'|'l / map buttons to joltage jumps
